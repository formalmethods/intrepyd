# Builds and tries out the Docker image of the REST service locally. Releases
# do not use this: the release workflow, .github/workflows/release.yml, builds
# the image from the wheel it has checked, tests it, and publishes it on
# ghcr.io/formalmethods/intrepyd and docker.io/robertobruttomesso/intrepid.
#
#   make -f Makefile.docker docker_test     build the image, run it, check it

PYTHON?=python3
IMAGE?=intrepyd
VERSION:=$(shell cat VERSION)
PORT?=8000

.PHONY: docker_build docker_run docker_stop docker_test

# The image installs the linux wheel from dist/: build it first, removing the
# linux wheels of other versions, which the Dockerfile would refuse
docker_build:
	@rm -f dist/intrepyd-*-manylinux_*_x86_64.whl
	@$(MAKE) --no-print-directory wheel PLATFORM=linux-x86_64
	@echo "# Building the image $(IMAGE):$(VERSION)"
	@docker build --build-arg VERSION=$(VERSION) -t $(IMAGE):$(VERSION) -t $(IMAGE):latest .

# Serves the REST API on http://127.0.0.1:$(PORT)
docker_run: docker_stop
	@docker run -d -p $(PORT):8000 --name=intrepyd $(IMAGE):$(VERSION) >/dev/null
	@echo "# The REST service is on http://127.0.0.1:$(PORT)/api/v1/"

docker_stop:
	@docker rm -f intrepyd >/dev/null 2>&1 || true

# What the release workflow checks before publishing the image
docker_test: docker_build docker_run
	@$(PYTHON) tools/check_image.py http://127.0.0.1:$(PORT); status=$$?; \
	if [ $$status -ne 0 ]; then docker logs intrepyd; fi; \
	docker rm -f intrepyd >/dev/null; exit $$status
